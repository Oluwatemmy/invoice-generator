# Copy this to `.env` for local dev and fill in real values.
# In production, set these as real environment variables on your host.

# Required: a random secret used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# Optional: connection string for a Postgres database (used in production).
# If unset, the app falls back to a local SQLite file at instance/invoices.db.
# Example: postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# Required for email verification: Resend API key and a verified sender address.
# Get the API key from https://resend.com/api-keys
# FROM_EMAIL must match a verified domain or sender in your Resend account.
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com
